<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           vc:minVersion="1.1">

  <xs:annotation>
    <xs:documentation xml:lang="fr">
      Schéma de configuration.
      Requiert XSD 1.1 (xs:alternative, xs:assert).
      Les références EX-xx renvoient aux exigences.
    </xs:documentation>
  </xs:annotation>

  <!-- ============================================================
       Racine
       ============================================================ -->

  <xs:element name="root">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Racine du document : définition des profils, puis arbre de noeuds A. (EX-01)
        Seul élément global du schéma, donc seule racine de document possible.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="profiles">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              Liste des profils utilisables dans le document. (EX-02)
            </xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="profile" type="Identifier" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation xml:lang="fr">
                    Définition d'un profil (ex. admin). Chaque profil est défini une seule fois. (EX-02)
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="A" type="NodeType" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              Noeud de premier niveau. Voir NodeType.
            </xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:assert test="every $p in .//parameter/profile satisfies $p = profiles/profile">
        <xs:annotation>
          <xs:documentation xml:lang="fr">
            Tout profil cité dans un paramètre doit être défini dans profiles. (EX-10)
            Assertion plutôt que xs:keyref : certains validateurs ignorent les
            contraintes d'identité sous un élément typé par xs:alternative.
          </xs:documentation>
        </xs:annotation>
      </xs:assert>
    </xs:complexType>

    <xs:unique name="uniqueProfileDefinition">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          Un profil n'est défini qu'une seule fois. (EX-02)
        </xs:documentation>
      </xs:annotation>
      <xs:selector xpath="profiles/profile"/>
      <xs:field xpath="."/>
    </xs:unique>

    <xs:unique name="uniqueNodeId">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          L'id d'un noeud A est unique parmi tous les noeuds A du document. (EX-03)
        </xs:documentation>
      </xs:annotation>
      <xs:selector xpath=".//A"/>
      <xs:field xpath="@id"/>
    </xs:unique>

    <xs:unique name="uniqueParameterId">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          L'id d'un paramètre est unique parmi tous les paramètres du document. (EX-05)
        </xs:documentation>
      </xs:annotation>
      <xs:selector xpath=".//parameter"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <!-- ============================================================
       Noeud A
       ============================================================ -->

  <xs:complexType name="NodeType">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Noeud A : un type optionnel, ses paramètres, puis ses noeuds enfants.
        Structure récursive, profondeur illimitée. (EX-03, EX-04, EX-11)
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="type" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="fr">
            Type du noeud, texte libre, facultatif. (EX-11)
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parameter" type="ParameterBase" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="fr">
            Paramètre du noeud. Son contenu dépend de l'attribut type :
            le type réel est choisi par les xs:alternative ci-dessous. (EX-05, EX-06)
          </xs:documentation>
        </xs:annotation>
        <xs:alternative test="@type = 'int'"         type="IntParameter"/>
        <xs:alternative test="@type = 'float'"       type="FloatParameter"/>
        <xs:alternative test="@type = 'string'"      type="StringParameter"/>
        <xs:alternative test="@type = 'hexadecimal'" type="HexParameter"/>
        <xs:alternative type="xs:error"/>
      </xs:element>
      <xs:element name="A" type="NodeType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="fr">
            Noeud enfant. Voir NodeType.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          Nom du noeud (non unique). (EX-03)
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="id" type="Identifier" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          Identifiant du noeud, unique parmi les noeuds A. (EX-03)
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ============================================================
       Paramètres
       ============================================================ -->

  <xs:complexType name="ParameterBase" abstract="true">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Base abstraite de tous les paramètres : attributs communs, hérités par extension.
        Jamais utilisée seule : le type réel est choisi selon l'attribut type. (EX-05)
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="id" type="Identifier" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          Identifiant du paramètre, unique parmi tous les paramètres. (EX-05)
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="Identifier" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          Nom du paramètre (non unique). (EX-05)
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="ValueKind" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          Type de la valeur ; détermine le contenu du paramètre. (EX-05, EX-06)
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:assert test="count(profile) = count(distinct-values(profile))">
      <xs:annotation>
        <xs:documentation xml:lang="fr">
          Un profil apparaît au plus une fois par paramètre. (EX-10)
        </xs:documentation>
      </xs:annotation>
    </xs:assert>
  </xs:complexType>

  <xs:complexType name="IntParameter">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Paramètre entier (type="int"), bornes min et max obligatoires. (EX-06, EX-07, EX-08)
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ParameterBase">
        <xs:sequence>
          <xs:element name="value" type="xs:int">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Valeur entière signée 32 bits. (EX-06)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="min" type="IntBound">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Borne minimale de la valeur. (EX-07)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="max" type="IntBound">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Borne maximale de la valeur. (EX-07)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:group ref="ProfileAccessList"/>
        </xs:sequence>
        <xs:assert test="if (string(min/@inclusive) = 'true') then xs:int(value) ge xs:int(min)
                                                               else xs:int(value) gt xs:int(min)">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              La valeur respecte la borne min. (EX-08)
            </xs:documentation>
          </xs:annotation>
        </xs:assert>
        <xs:assert test="if (string(max/@inclusive) = 'true') then xs:int(value) le xs:int(max)
                                                               else xs:int(value) lt xs:int(max)">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              La valeur respecte la borne max. (EX-08)
            </xs:documentation>
          </xs:annotation>
        </xs:assert>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FloatParameter">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Paramètre flottant (type="float"), bornes min et max obligatoires. (EX-06, EX-07, EX-08)
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ParameterBase">
        <xs:sequence>
          <xs:element name="value" type="xs:float">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Valeur flottante 32 bits. (EX-06)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="min" type="FloatBound">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Borne minimale de la valeur. (EX-07)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="max" type="FloatBound">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Borne maximale de la valeur. (EX-07)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:group ref="ProfileAccessList"/>
        </xs:sequence>
        <xs:assert test="if (string(min/@inclusive) = 'true') then xs:float(value) ge xs:float(min)
                                                               else xs:float(value) gt xs:float(min)">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              La valeur respecte la borne min. (EX-08)
            </xs:documentation>
          </xs:annotation>
        </xs:assert>
        <xs:assert test="if (string(max/@inclusive) = 'true') then xs:float(value) le xs:float(max)
                                                               else xs:float(value) lt xs:float(max)">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              La valeur respecte la borne max. (EX-08)
            </xs:documentation>
          </xs:annotation>
        </xs:assert>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StringParameter">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Paramètre texte (type="string"), sans bornes. (EX-06, EX-07)
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ParameterBase">
        <xs:sequence>
          <xs:element name="value" type="xs:string">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Valeur texte libre. (EX-06)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:group ref="ProfileAccessList"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="HexParameter">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Paramètre hexadécimal (type="hexadecimal"), sans bornes. (EX-06, EX-07)
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ParameterBase">
        <xs:sequence>
          <xs:element name="value" type="HexValue">
            <xs:annotation>
              <xs:documentation xml:lang="fr">
                Valeur hexadécimale, sans préfixe 0x. (EX-06)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:group ref="ProfileAccessList"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ============================================================
       Bornes
       ============================================================ -->

  <xs:complexType name="IntBound">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Borne entière, incluse ou exclue. (EX-07)
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:int">
        <xs:attribute name="inclusive" type="StrictBoolean" use="required">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              true : borne incluse ; false : borne exclue. (EX-07)
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="FloatBound">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Borne flottante, incluse ou exclue. (EX-07)
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:float">
        <xs:attribute name="inclusive" type="StrictBoolean" use="required">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              true : borne incluse ; false : borne exclue. (EX-07)
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ============================================================
       Droits des profils sur un paramètre
       ============================================================ -->

  <xs:group name="ProfileAccessList">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Liste des profils autorisés sur un paramètre, avec leur droit. (EX-09)
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="profile" type="ProfileAccess" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="fr">
            Profil autorisé sur ce paramètre ; doit être défini dans profiles. (EX-09, EX-10)
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:group>

  <xs:complexType name="ProfileAccess">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Référence à un profil défini, avec son droit d'accès. (EX-09)
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="Identifier">
        <xs:attribute name="right" type="AccessRight" use="required">
          <xs:annotation>
            <xs:documentation xml:lang="fr">
              Droit du profil sur le paramètre. (EX-09)
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ============================================================
       Types simples
       ============================================================ -->

  <xs:simpleType name="Identifier">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Identifiant : non vide, sans espace.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="\S+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StrictBoolean">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Booléen limité à true | false (1 et 0 refusés).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:boolean">
      <xs:pattern value="true|false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ValueKind">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Types de valeur possibles pour un paramètre. (EX-05)
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="int">
        <xs:annotation>
          <xs:documentation xml:lang="fr">Entier signé 32 bits.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="float">
        <xs:annotation>
          <xs:documentation xml:lang="fr">Flottant 32 bits.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="string">
        <xs:annotation>
          <xs:documentation xml:lang="fr">Texte libre.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="hexadecimal">
        <xs:annotation>
          <xs:documentation xml:lang="fr">Chiffres hexadécimaux.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HexValue">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Chiffres hexadécimaux, majuscules ou minuscules, sans préfixe.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-Fa-f]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AccessRight">
    <xs:annotation>
      <xs:documentation xml:lang="fr">
        Droits d'accès d'un profil sur un paramètre. (EX-09)
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="r">
        <xs:annotation>
          <xs:documentation xml:lang="fr">Lecture seule.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="rw">
        <xs:annotation>
          <xs:documentation xml:lang="fr">Lecture et écriture.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>



