# nginx-deploy.yml — nginx sur k3s airgap
# Appliquer :  kubectl apply -f nginx-deploy.yml
# Tester    :  curl http://<IP_NOEUD>:30080
# Supprimer :  kubectl delete -f nginx-deploy.yml
---
apiVersion: v1
kind: Namespace
metadata:
  name: demo
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx
  namespace: demo
  labels:
    app: nginx
spec:
  replicas: 2
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
        - name: nginx
          # Nom EXACT de l'image dans le tarball (vérifier : sudo /usr/local/bin/k3s crictl images)
          image: docker.io/library/nginx:alpine
          # Airgap : jamais de pull. Image absente => ErrImageNeverPull immédiat et explicite.
          imagePullPolicy: Never
          ports:
            - name: http
              containerPort: 80
          resources:
            requests:
              cpu: 50m
              memory: 32Mi
            limits:
              memory: 128Mi
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: nginx
  namespace: demo
spec:
  type: NodePort
  selector:
    app: nginx
  ports:
    - name: http
      port: 80
      targetPort: http
      nodePort: 30080   # plage autorisée : 30000-32767